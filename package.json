{
  "name": "dsh-plugin-rhinelab-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "RhineLabUI 3D archive room as a DeepSeek Harness (dsh) client UI plugin: real sessions, live conversation, model viewer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "three.js",
    "rhine-lab"
  ],
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/index.js",
    "plugin/client.js",
    "cordis.patch.yml",
    "rhine-dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "verify": "node scripts/verify-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<owner>/dsh-plugin-rhinelab-ui.git"
  },
  "bugs": {
    "url": "https://github.com/<owner>/dsh-plugin-rhinelab-ui/issues"
  },
  "homepage": "https://github.com/<owner>/dsh-plugin-rhinelab-ui#readme",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  }
}
